namespace Windows.UI.Xaml {
    typedef struct Thickness Thickness;

    struct Thickness
    {
        DOUBLE Left;
        DOUBLE Top;
        DOUBLE Right;
        DOUBLE Bottom;
    };
}

namespace Windows.UI.Text {
    typedef struct FontWeight FontWeight;

    struct FontWeight
    {
        UINT16 Weight;
    };
}

